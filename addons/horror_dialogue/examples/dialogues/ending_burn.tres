[sub_resource type="Resource" id="Resource_b1"]
script = ExtResource("1_line")
speaker_name = "MC"
speaker_color = Color(0.85, 0.88, 0.95, 1)
text = "Maafin gua, Mir... catatan itu benar. Perubahan lu udah terlalu jauh. 'Jangan coba menyembuhkannya. Bakar.'"
typing_speed = 0.04

[sub_resource type="Resource" id="Resource_b2"]
script = ExtResource("1_line")
speaker_name = "MC"
speaker_color = Color(1.0, 0.4, 0.2, 1)
text = "[shake rate=25 level=8]KLIK! FUSHHH![/shake] Api korek menyambar tumpukan bunga dan tubuh Amir!"
typing_speed = 0.035
event_signal = "ignite_fire_ritual"

[sub_resource type="Resource" id="Resource_b3"]
script = ExtResource("1_line")
speaker_name = "Amir"
speaker_color = Color(1.0, 0.1, 0.1, 1)
text = "[shake rate=40 level=12][color=red]TERIMA KASIH... MC...[/color][/shake]"
typing_speed = 0.03

[sub_resource type="Resource" id="Resource_b4"]
script = ExtResource("1_line")
speaker_name = "NARASI"
speaker_color = Color(0.7, 0.7, 0.7, 1)
text = "Hening. Abu berhamburan ke langit malam. Hutan di kejauhan sunyi. MC berdiri menatap tangannya sendiri..."
typing_speed = 0.035

[sub_resource type="Resource" id="Resource_b5"]
script = ExtResource("1_line")
speaker_name = "MC"
speaker_color = Color(0.9, 0.3, 0.3, 1)
text = "[shake rate=20 level=5]Tunggu... apa ini di pergelangan tanganku...? Dua titik ungu berdenyut...[/shake]"
typing_speed = 0.04

[sub_resource type="Resource" id="Resource_b6"]
script = ExtResource("1_line")
speaker_name = "ENDING 2: BAKAR"
speaker_color = Color(1.0, 0.2, 0.2, 1)
text = "[color=red][b]MALAPETAKA.[/b] Api memusnahkan monster itu, namun kutukan kupu-kupu malam kini berpindah kepadamu.[/color]"
typing_speed = 0.025

[resource]
script = ExtResource("2_data")
