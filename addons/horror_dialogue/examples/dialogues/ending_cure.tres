[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("1_line")
speaker_name = "NARASI"
speaker_color = Color(0.3, 0.9, 0.5, 1)
text = "Sayap transparan itu luruh menjadi serbuk hitam. Tubuh Amir ambruk di depan altar. Fajar perlahan menyingsing di atas rusun UNSRI..."
typing_speed = 0.035

[sub_resource type="Resource" id="Resource_c4"]
script = ExtResource("1_line")
speaker_name = "Amir"
speaker_color = Color(0.95, 0.8, 0.6, 1)
text = "MC...? Kita... beneran masih hidup?"
