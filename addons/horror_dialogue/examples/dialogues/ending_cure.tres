speaker_name = "ENDING 1: PULIH"
speaker_color = Color(0.2, 0.8, 1.0, 1)
text = "[color=green][b]SELAMAT![/b] Kamu berhasil mengembalikan 8 bunga kehidupan dan menyembuhkan Amir dari kutukan kupu-kupu malam.[/color]"
