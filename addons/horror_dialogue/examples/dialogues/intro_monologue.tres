[sub_resource type="Resource" id="Resource_line_2"]
script = ExtResource("1_line")
speaker_name = "Aku"
speaker_color = Color(0.85, 0.88, 0.95, 1)
text = "Pintunya terkunci dari luar. Bau busuk ini... berasal dari ujung lorong."

[sub_resource type="Resource" id="Resource_line_3"]
script = ExtResource("1_line")
